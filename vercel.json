{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/podcast",
      "destination": "/podcast/index.html"
    },
    {
      "source": "/founders",
      "destination": "/founders/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/results",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/work",
      "permanent": true
    }
  ]
}
